options(stringsAsFactors = FALSE)
trimSeuratData <- function(seuratObj, min.cells){
cell.excludes <- which(as.numeric(table(Idents(seuratObj))) < min.cells)
cell.excludes <- as.array(cell.excludes)
if(length(cell.excludes)>0){
cell.to.exclude <- array()
for (cellnum in 1:length(cell.excludes)){
cell.to.exclude[cellnum] <- levels(Idents(seuratObj))[cell.excludes[cellnum]]
}
cell.to.exclude <- as.list(cell.to.exclude)
seuratObj <- subset(x = seuratObj, idents = cell.to.exclude, invert = TRUE)
}
return(seuratObj)
}
View(merged_nw@meta.data)
