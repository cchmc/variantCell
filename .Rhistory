target = paste0(output_prefix, "_Summary.docx"))
# 3. diagnostics (ICC)
ic <- icc_summary %>% mutate(`ICC (%)` = paste0(ICC_Percent, "%")) %>%
select(Marker, `ICC (%)`, Interpretation)
print(hdr("Model Diagnostics (ICC)") %>%
body_add_flextable(style_ft(flextable(ic))) %>%
body_add_par("", style = "Normal") %>%
body_add_par("ICC = fraction of variance from between-sample clustering.",
style = "Normal"),
target = paste0(output_prefix, "_Diagnostics.docx"))
# 4. sample-level
st <- sample_summary %>%
mutate(across(starts_with("Percent"), ~ sprintf("%.1f", .x))) %>%
select(Group, Sample, Total_Cells,
ACTA2 = Percent_ACTA2, pS6 = Percent_PS6, Tnc = Percent_Tnc,
`ACTA2+/pS6+` = Percent_Dual)
print(hdr("Sample-Level Results") %>%
body_add_flextable(style_ft(flextable(st))) %>%
body_add_par("", style = "Normal") %>%
body_add_par("One row per biological sample. Values are % positive cells.",
style = "Normal"),
target = paste0(output_prefix, "_Samples.docx"))
cat("Wrote 4 Word docs with prefix:", output_prefix, "\n")
}
export_tables()
# Save analysis objects
saveRDS(list(all_results = all_results, sample_summary = sample_summary,
group_summary = group_summary, icc_summary = icc_summary,
models = map(analyses, "model")),
file.path(out_dir, "IF_analysis_results.rds"))
library(tidyverse)
library(lme4)
library(emmeans)
library(patchwork)
library(knitr)
library(officer)
library(flextable)
# Guard against matrixStats/plyr masking dplyr verbs (corrupts grouped summaries)
suppressWarnings({
library(conflicted)
conflict_prefer("count",  "dplyr", quiet = TRUE)
conflict_prefer("filter", "dplyr", quiet = TRUE)
conflict_prefer("select", "dplyr", quiet = TRUE)
conflict_prefer("mean",   "base",  quiet = TRUE)
conflict_prefer("sum",    "base",  quiet = TRUE)
})
out_dir <- "/home/andrew/Desktop/D-Drive/IF/Murine/071626/IF_analysis"
# -----------------------------------------------------------------------------
# THRESHOLDS  — paste the values chosen from the helper's "Suggested" output
# -----------------------------------------------------------------------------
ACTA2_threshold <- 275   # Otsu (structural marker; avoids inflating aSMA+)
PS6_threshold   <- 164   # 3-method consensus (Otsu/GMM/Ctrl-p95 agree)
Tnc_threshold   <- 50    # Otsu (below compressed Ctrl-p95/p99 window)
# Auto-load helper suggestions if you left them NA
if (any(is.na(c(ACTA2_threshold, PS6_threshold, Tnc_threshold)))) {
tr <- read_tsv(file.path(out_dir, "threshold_report.tsv"), show_col_types = FALSE)
if (is.na(ACTA2_threshold)) ACTA2_threshold <- tr$Suggested[tr$Marker == "ACTA2"]
if (is.na(PS6_threshold))   PS6_threshold   <- tr$Suggested[tr$Marker == "PS6"]
if (is.na(Tnc_threshold))   Tnc_threshold   <- tr$Suggested[tr$Marker == "Tnc"]
cat("Using helper-suggested thresholds:\n")
}
cat(sprintf("  ACTA2=%.0f  pS6=%.0f  Tnc=%.0f\n",
ACTA2_threshold, PS6_threshold, Tnc_threshold))
# -----------------------------------------------------------------------------
# LOAD ARTIFACT-FLAGGED CELLS, DROP ARTIFACTS, CLASSIFY POSITIVITY
# -----------------------------------------------------------------------------
dat_flagged <- readRDS(file.path(out_dir, "cells_flagged.rds"))
data_processed <- dat_flagged %>%
filter(!artifact) %>%                                   # <- artifact removal
filter(!is.na(ACTA2_Mean), !is.na(PS6_Mean), !is.na(Tnc_Mean)) %>%
mutate(
ACTA2_Positive = ACTA2_Mean >= ACTA2_threshold,
PS6_Positive   = PS6_Mean   >= PS6_threshold,
Tnc_Positive   = Tnc_Mean   >= Tnc_threshold,
Dual_Positive  = ACTA2_Positive & PS6_Positive,       # aSMA+ / pS6+
Group  = factor(Group,  levels = c("Control", "ACR")),
Sample = factor(Sample)
)
cat("\nCells retained after artifact removal:", nrow(data_processed), "\n")
markers <- c("ACTA2_Positive", "PS6_Positive", "Tnc_Positive", "Dual_Positive")
marker_labels <- c(ACTA2_Positive = "ACTA2 (aSMA)",
PS6_Positive   = "pS6",
Tnc_Positive   = "Tnc",
Dual_Positive  = "ACTA2+/pS6+")
# =============================================================================
# SUMMARY TABLES (sample- and group-level)
# =============================================================================
sample_summary <- data_processed %>%
group_by(Group, Sample) %>%
summarise(
Total_Cells = n(),
ACTA2_Pos = sum(ACTA2_Positive), PS6_Pos = sum(PS6_Positive),
Tnc_Pos   = sum(Tnc_Positive),   Dual_Pos = sum(Dual_Positive),
Percent_ACTA2 = 100 * mean(ACTA2_Positive),
Percent_PS6   = 100 * mean(PS6_Positive),
Percent_Tnc   = 100 * mean(Tnc_Positive),
Percent_Dual  = 100 * mean(Dual_Positive),
.groups = "drop"
) %>% arrange(Group, Sample)
cat("\n=== SAMPLE-LEVEL SUMMARY ===\n")
print(sample_summary %>%
mutate(across(starts_with("Percent"), ~ round(.x, 2))) %>%
select(Group, Sample, Total_Cells, starts_with("Percent")))
group_summary <- sample_summary %>%
group_by(Group) %>%
summarise(
n_samples = n(),
Mean_ACTA2 = mean(Percent_ACTA2), SD_ACTA2 = sd(Percent_ACTA2),
Mean_PS6   = mean(Percent_PS6),   SD_PS6   = sd(Percent_PS6),
Mean_Tnc   = mean(Percent_Tnc),   SD_Tnc   = sd(Percent_Tnc),
Mean_Dual  = mean(Percent_Dual),  SD_Dual  = sd(Percent_Dual),
.groups = "drop"
)
cat("\n=== GROUP SUMMARY (mean +/- SD across samples) ===\n")
group_table <- group_summary %>%
mutate(
`ACTA2+ (%)` = sprintf("%.1f +/- %.1f", Mean_ACTA2, SD_ACTA2),
`pS6+ (%)`   = sprintf("%.1f +/- %.1f", Mean_PS6,   SD_PS6),
`Tnc+ (%)`   = sprintf("%.1f +/- %.1f", Mean_Tnc,   SD_Tnc),
`ACTA2+/pS6+ (%)` = sprintf("%.1f +/- %.1f", Mean_Dual, SD_Dual)
) %>%
select(Group, n_samples, `ACTA2+ (%)`, `pS6+ (%)`, `Tnc+ (%)`, `ACTA2+/pS6+ (%)`)
print(kable(group_table, align = "c"))
# =============================================================================
# MIXED-EFFECTS:  outcome ~ Group + (1 | Sample)   [binomial, cell-level]
# =============================================================================
perform_mixed_effects_analysis <- function(data, outcome_var, marker_name) {
cat("\n--- ", marker_name, " ---\n", sep = "")
md <- data %>%
mutate(outcome = as.numeric(.data[[outcome_var]])) %>%
filter(!is.na(outcome))
model <- glmer(outcome ~ Group + (1 | Sample),
data = md, family = binomial,
control = glmerControl(optimizer = "bobyqa"))
fe  <- fixef(model); se <- sqrt(diag(vcov(model)))
sm  <- summary(model)
pv  <- sm$coefficients[, "Pr(>|z|)"]
results <- tibble(
Marker = marker_name,
Comparison = names(fe),
Estimate = fe, SE = se,
OR = exp(fe), CI_Lower = exp(fe - 1.96 * se), CI_Upper = exp(fe + 1.96 * se),
P_Value = pv
) %>% filter(Comparison == "GroupACR") %>%
mutate(Comparison = "ACR vs Control")
# ICC
vc <- as.numeric(VarCorr(model)$Sample[1])
icc <- vc / (vc + pi^2 / 3)
cat(sprintf("  OR=%.2f (%.2f-%.2f)  p=%.4g  ICC=%.1f%%\n",
results$OR, results$CI_Lower, results$CI_Upper,
results$P_Value, 100 * icc))
list(results = results, model = model, icc = icc)
}
analyses <- map(markers, ~ perform_mixed_effects_analysis(data_processed, .x, marker_labels[[.x]]))
names(analyses) <- markers
all_results <- map_dfr(analyses, "results") %>%
mutate(
P_Adjusted = p.adjust(P_Value, method = "BH"),
Significance_Adj = case_when(
P_Adjusted < 0.001 ~ "***", P_Adjusted < 0.01 ~ "**",
P_Adjusted < 0.05 ~ "*",    P_Adjusted < 0.1 ~ ".", TRUE ~ "ns")
)
icc_summary <- tibble(
Marker = map_chr(analyses, ~ .x$results$Marker),
ICC_Percent = round(100 * map_dbl(analyses, "icc"), 1)
) %>%
mutate(Interpretation = case_when(
ICC_Percent >= 20 ~ "Substantial", ICC_Percent >= 10 ~ "Moderate",
ICC_Percent >= 5  ~ "Low", TRUE ~ "Negligible"))
cat("\n=== CELL-LEVEL MIXED-EFFECTS (SECONDARY / sensitivity only) ===\n")
cat("NOTE: ACTA2 & Dual show complete separation (Control 0%). Cell-level ORs\n")
cat("are not interpretable at n=7; sample-level test below is PRIMARY.\n")
print(kable(all_results %>%
mutate(`OR (95% CI)` = sprintf("%.2f (%.2f-%.2f)", OR, CI_Lower, CI_Upper),
`p` = sprintf("%.4g", P_Value),
`p (BH)` = sprintf("%.4g", P_Adjusted)) %>%
select(Marker, `OR (95% CI)`, `p`, `p (BH)`, Significance_Adj),
align = "c"))
# =============================================================================
# PRIMARY STATISTIC — SAMPLE-LEVEL (n = 7 mice, not cells)
#   Avoids pseudoreplication AND separation. Two convergent tests per marker:
#     (1) Exact Wilcoxon rank-sum on sample %positive  (reviewer-expected)
#     (2) Permutation test on arcsine-sqrt proportions  (robust w/ 0-inflation)
#   Effect size: raw difference in mean %positive (Control -> ACR).
# =============================================================================
set.seed(1)
perm_test <- function(x, g, n_perm = 10000) {
# difference in means on arcsine-sqrt scale; two-sided permutation p
as_tr <- function(p) asin(sqrt(pmin(pmax(p / 100, 0), 1)))
t_obs <- abs(mean(as_tr(x[g == "ACR"])) - mean(as_tr(x[g == "Control"])))
perms <- replicate(n_perm, {
gp <- sample(g)
abs(mean(as_tr(x[gp == "ACR"])) - mean(as_tr(x[gp == "Control"])))
})
(sum(perms >= t_obs) + 1) / (n_perm + 1)   # +1 = never report p = 0
}
sample_level_test <- map_dfr(
c(Percent_ACTA2 = "ACTA2 (aSMA)", Percent_PS6 = "pS6",
Percent_Tnc = "Tnc", Percent_Dual = "ACTA2+/pS6+"),
function(lbl) {
col <- names(which(c(Percent_ACTA2 = "ACTA2 (aSMA)", Percent_PS6 = "pS6",
Percent_Tnc = "Tnc", Percent_Dual = "ACTA2+/pS6+") == lbl))
x <- sample_summary[[col]]; g <- as.character(sample_summary$Group)
ctrl <- x[g == "Control"]; acr <- x[g == "ACR"]
tibble(
Marker    = lbl,
Control   = sprintf("%.1f +/- %.1f", mean(ctrl), sd(ctrl)),
ACR       = sprintf("%.1f +/- %.1f", mean(acr),  sd(acr)),
Diff      = round(mean(acr) - mean(ctrl), 1),
Wilcox_p  = wilcox.test(x ~ g, exact = TRUE)$p.value,
Perm_p    = perm_test(x, g)
)
}, .id = NULL) %>%
mutate(
Wilcox_p_BH = p.adjust(Wilcox_p, "BH"),
Perm_p_BH   = p.adjust(Perm_p,   "BH"),
Significance = case_when(
Perm_p_BH < 0.001 ~ "***", Perm_p_BH < 0.01 ~ "**",
Perm_p_BH < 0.05 ~ "*",    Perm_p_BH < 0.1 ~ ".", TRUE ~ "ns")
)
cat("\n=== PRIMARY: SAMPLE-LEVEL TEST (n=7) ===\n")
print(kable(sample_level_test %>%
mutate(`Wilcoxon p (BH)` = sprintf("%.3f", Wilcox_p_BH),
`Perm p (BH)`     = sprintf("%.4f", Perm_p_BH)) %>%
select(Marker, Control, ACR, Diff, `Wilcoxon p (BH)`, `Perm p (BH)`, Significance),
align = "c"))
cat("\nNote: exact Wilcoxon floor at n=3v4 is p=0.057 (can't reach 0.05);\n")
cat("permutation test on arcsine-root proportions is primary. Diff = ACR - Control (percentage points).\n")
# Figure significance now comes from the SAMPLE-LEVEL test, not glmer
sig_lookup <- sample_level_test %>%
transmute(Marker, Sig = Significance, P_Adjusted = Perm_p_BH)
# =============================================================================
# VISUALIZATION — 4 panels (ACTA2, pS6, Tnc, ACTA2+/pS6+)
#   Control vs ACR box+jitter, sample-level significance star per panel.
# =============================================================================
plot_data <- sample_summary %>%
select(Group, Sample, Percent_ACTA2, Percent_PS6, Percent_Tnc, Percent_Dual) %>%
pivot_longer(starts_with("Percent"), names_to = "Marker", values_to = "Pct") %>%
mutate(Marker = recode(Marker,
Percent_ACTA2 = "ACTA2 (aSMA)", Percent_PS6 = "pS6",
Percent_Tnc = "Tnc", Percent_Dual = "ACTA2+/pS6+"),
Marker = factor(Marker, levels = c("ACTA2 (aSMA)", "pS6", "Tnc", "ACTA2+/pS6+")),
Group  = factor(Group, levels = c("Control", "ACR")))
group_colors <- c(Control = "#2C7FB8", ACR = "#D95F0E")
make_panel <- function(mk) {
d  <- plot_data %>% filter(Marker == mk)
sg <- sig_lookup %>% filter(Marker == mk)
ymax <- max(d$Pct, na.rm = TRUE)
ggplot(d, aes(Group, Pct, fill = Group)) +
geom_boxplot(alpha = 0.85, outlier.shape = NA, width = 0.55) +
geom_jitter(width = 0.12, size = 2.6, alpha = 0.9, color = "black") +
annotate("segment", x = 1, xend = 2, y = ymax * 1.12, yend = ymax * 1.12) +
annotate("text", x = 1.5, y = ymax * 1.18, label = sg$Sig, size = 5) +
scale_fill_manual(values = group_colors) +
scale_y_continuous(labels = function(x) paste0(x, "%"),
expand = expansion(mult = c(0.02, 0.15))) +
labs(title = mk, x = NULL, y = "Positive cells (%)") +
theme_minimal(base_size = 13) +
theme(legend.position = "none",
panel.grid.minor = element_blank(),
panel.grid.major.x = element_blank(),
plot.title = element_text(face = "bold", hjust = 0.5))
}
panels <- map(levels(plot_data$Marker), make_panel)
# Side-by-side (1 row) and stacked (1 col) versions
fig_row <- wrap_plots(panels, nrow = 1)
fig_col <- wrap_plots(panels, ncol = 1)
ggsave(file.path(out_dir, "Figure_IF_panels_sidebyside.pdf"), fig_row, width = 14, height = 4.2)
ggsave(file.path(out_dir, "Figure_IF_panels_stacked.pdf"),     fig_col, width = 4.5, height = 14)
cat("\nWrote Figure_IF_panels_sidebyside.pdf and Figure_IF_panels_stacked.pdf\n")
# =============================================================================
# WORD EXPORT (results / summary / diagnostics / samples)
# =============================================================================
export_tables <- function(output_prefix = file.path(out_dir, "IF_ACR_Analysis"),
study_title = "Murine LTx ACR IF Analysis",
author_name = "Andrew Potter") {
hdr <- function(title) read_docx() %>%
set_doc_properties(title = title, author = author_name, created = Sys.Date()) %>%
body_add_par(title, style = "heading 1") %>%
body_add_par(paste("Generated:", Sys.Date()), style = "Normal") %>%
body_add_par("", style = "Normal")
style_ft <- function(ft) ft %>% theme_vanilla() %>%
fontsize(size = 11, part = "all") %>% align(align = "center", part = "all") %>%
bold(part = "header") %>% bg(bg = "#f0f0f0", part = "header") %>%
border_outer(part = "all", border = fp_border(color = "black", width = 1)) %>%
border_inner_h(border = fp_border(color = "gray", width = 0.5)) %>%
border_inner_v(border = fp_border(color = "gray", width = 0.5))
# 1a. PRIMARY: sample-level test
slt <- sample_level_test %>%
mutate(`Diff (pp)` = sprintf("%+.1f", Diff),
`Perm p (BH)` = sprintf("%.4f", Perm_p_BH),
`Wilcoxon p (BH)` = sprintf("%.3f", Wilcox_p_BH)) %>%
select(Marker, Control, ACR, `Diff (pp)`,
`Perm p (BH)`, `Wilcoxon p (BH)`, Sig = Significance)
ft_primary <- style_ft(flextable(slt))
sig_rows_p <- which(sample_level_test$Perm_p_BH < 0.05)
if (length(sig_rows_p)) ft_primary <- bg(ft_primary, i = sig_rows_p, bg = "#fff2cc", part = "body")
# 1b. SECONDARY: cell-level ORs (flagged as separation-affected)
rt <- all_results %>%
mutate(`OR (95% CI)` = sprintf("%.2f (%.2f-%.2f)", OR, CI_Lower, CI_Upper),
`P-value` = sprintf("%.4g", P_Value),
`Adj. P` = sprintf("%.4g", P_Adjusted)) %>%
select(Marker, Comparison, `OR (95% CI)`, `P-value`, `Adj. P`, Sig = Significance_Adj)
ft1 <- style_ft(flextable(rt))
print(hdr("Primary Results — Sample-Level (n=7 mice)") %>%
body_add_flextable(ft_primary) %>%
body_add_par("", style = "Normal") %>%
body_add_par("Values: mean +/- SD %positive across biological replicates (Control n=3, ACR n=4). Diff = ACR - Control (percentage points). Primary p = two-sided permutation test on arcsine-root proportions, BH-adjusted; exact Wilcoxon shown for reference (floor p=0.057 at this n). Yellow = BH p < 0.05.", style = "Normal") %>%
body_add_par("", style = "Normal") %>%
body_add_par("Secondary — Cell-Level Mixed-Effects (sensitivity)", style = "heading 2") %>%
body_add_flextable(ft1) %>%
body_add_par("", style = "Normal") %>%
body_add_par("Model: outcome ~ Group + (1|Sample), binomial. CAUTION: ACTA2 and ACTA2+/pS6+ exhibit complete separation (Control = 0%); odds ratios are non-estimable and reported only to show direction/consistency, not as effect sizes.",
style = "Normal"),
target = paste0(output_prefix, "_Results.docx"))
# 2. group summary
print(hdr("Group Summary Statistics") %>%
body_add_flextable(style_ft(flextable(group_table))) %>%
body_add_par("", style = "Normal") %>%
body_add_par("Mean +/- SD across biological samples.", style = "Normal"),
target = paste0(output_prefix, "_Summary.docx"))
# 3. diagnostics (ICC)
ic <- icc_summary %>% mutate(`ICC (%)` = paste0(ICC_Percent, "%")) %>%
select(Marker, `ICC (%)`, Interpretation)
print(hdr("Model Diagnostics (ICC)") %>%
body_add_flextable(style_ft(flextable(ic))) %>%
body_add_par("", style = "Normal") %>%
body_add_par("ICC = fraction of variance from between-sample clustering.",
style = "Normal"),
target = paste0(output_prefix, "_Diagnostics.docx"))
# 4. sample-level
st <- sample_summary %>%
mutate(across(starts_with("Percent"), ~ sprintf("%.1f", .x))) %>%
select(Group, Sample, Total_Cells,
ACTA2 = Percent_ACTA2, pS6 = Percent_PS6, Tnc = Percent_Tnc,
`ACTA2+/pS6+` = Percent_Dual)
print(hdr("Sample-Level Results") %>%
body_add_flextable(style_ft(flextable(st))) %>%
body_add_par("", style = "Normal") %>%
body_add_par("One row per biological sample. Values are % positive cells.",
style = "Normal"),
target = paste0(output_prefix, "_Samples.docx"))
cat("Wrote 4 Word docs with prefix:", output_prefix, "\n")
}
export_tables()
# Save analysis objects (NOT the merMod models — they blow the C stack on serialize)
model_diagnostics <- imap_dfr(analyses, function(a, mk) {
tibble(
Marker   = a$results$Marker,
ICC      = a$icc,
n_obs    = nobs(a$model),
singular = isSingular(a$model)
)
})
saveRDS(list(all_results       = all_results,
sample_level_test = sample_level_test,   # PRIMARY result
sample_summary    = sample_summary,
group_summary     = group_summary,
icc_summary       = icc_summary,
model_diagnostics = model_diagnostics),
file.path(out_dir, "IF_analysis_results.rds"))
cat("\nDone. Results saved to IF_analysis_results.rds\n")
print(model_diagnostics)
